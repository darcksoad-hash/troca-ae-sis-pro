# Modo local:
# deixe DATABASE_URL vazio para usar SQLite local em data/troca_ae.db
DATABASE_URL=

# Modo producao com PostgreSQL:
# DATABASE_URL=postgresql://usuario:senha@host:5432/troca_ae

# Opcional: use quando pg_dump/pg_restore nao estiverem no PATH do servidor.
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
# PG_RESTORE_PATH=C:\Program Files\PostgreSQL\16\bin\pg_restore.exe

PORT=5050

# Local: 127.0.0.1
# Nuvem/Docker: 0.0.0.0
HOST=127.0.0.1

# Local ou servidor com disco persistente:
# APP_STORAGE_ROOT=/caminho/seguro/para/dados
#
# Na Render gratuita, deixe vazio. Uploads e backups locais podem ser apagados
# quando o servico reiniciar. Para producao completa, use armazenamento externo.
APP_STORAGE_ROOT=

# Recomendado em producao:
# APP_ENV=production
# PUBLIC_URL=https://seu-dominio.com.br
